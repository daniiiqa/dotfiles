// Look neon — fastfetch: logo en dos tonos, flechas y colores brillantes
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "color": {
      "1": "bright_red",
      "2": "white"
    },
    "padding": {
      "top": 1,
      "right": 4
    }
  },
  "display": {
    "separator": "  ⟫  ",
    "color": {
      "keys": "bright_red",
      "separator": "white",
      "title": "white"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "// {user-name}@{host-name}",
      "color": {
        "user": "white",
        "host": "bright_red"
      }
    },
    "break",
    {
      "type": "os",
      "key": "OS    "
    },
    {
      "type": "kernel",
      "key": "KERNEL"
    },
    {
      "type": "wm",
      "key": "WM    "
    },
    {
      "type": "terminal",
      "key": "TERM  "
    },
    {
      "type": "shell",
      "key": "SHELL "
    },
    {
      "type": "cpu",
      "key": "CPU   "
    },
    {
      "type": "gpu",
      "key": "GPU   ",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "RAM   "
    },
    {
      "type": "uptime",
      "key": "UPTIME"
    },
    "break",
    {
      "type": "colors",
      "symbol": "block",
      "paddingLeft": 0
    },
    "break"
  ]
}
