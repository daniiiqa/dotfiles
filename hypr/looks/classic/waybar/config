	"group/apps": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 250,
			"children-class": "app-drawer",
			"transition-left-to-right": true
		},
		"modules": [
			"custom/apps-more",
			"custom/app-d1",
			"custom/app-d2",
			"custom/app-d3",
			"custom/app-d4",
			"custom/app-d5",
			"custom/app-d6",
			"custom/app-d7",
			"custom/app-d8"
		]
	},
	"custom/recorder": {
		"exec": "$HOME/.config/hypr/scripts/Recorder.sh status",
		"return-type": "json",
		"interval": 1,
		"signal": 10,
		"format": "{}",
		"tooltip": true,
		"on-click": "$HOME/.config/hypr/scripts/Recorder.sh click",
		"on-click-middle": "$HOME/.config/hypr/scripts/Recorder.sh pause",
		"on-click-right": "$HOME/.config/hypr/scripts/Recorder.sh menu"
	},
	"custom/visualizer": {
		"exec": "$HOME/.config/hypr/scripts/Visualizer.py",
		"return-type": "json",
		"format": "{}",
		"tooltip": true,
		"escape": false,
		"on-click": "playerctl previous",
		"on-click-middle": "playerctl play-pause",
		"on-click-right": "playerctl next",
		"on-scroll-up": "$HOME/.config/hypr/scripts/Volume.sh --inc",
		"on-scroll-down": "$HOME/.config/hypr/scripts/Volume.sh --dec",
		"smooth-scrolling-threshold": 1
