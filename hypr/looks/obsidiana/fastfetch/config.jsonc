// Look obsidiana — fastfetch: piedra y un reflejo
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  ··  ",
    "color": {
      "keys": "white",
      "separator": "bright_black"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[1;97m◆\u001b[0m  obsidiana   \u001b[95mvidrio de volcán\u001b[0m"
    },
    {
      "type": "title",
      "format": "{user-name} / {host-name}",
      "color": {
        "user": "bright_white",
        "at": "bright_black",
        "host": "magenta"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[90m─────────────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "os       "
    },
    {
      "type": "kernel",
      "key": "kernel   "
    },
    {
      "type": "wm",
      "key": "wm       "
    },
    {
      "type": "shell",
      "key": "shell    "
    },
    {
      "type": "terminal",
      "key": "term     "
    },
    {
      "type": "memory",
      "key": "mem      "
    },
    {
      "type": "uptime",
      "key": "despierto"
    },
    {
      "type": "custom",
      "format": "\u001b[90m─────────────────────────────────\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[90mse enfría despacio\u001b[0m"
    },
    "break"
  ]
}
