/* Dany Obsidiana — el menú sale de abajo, junto a la barra: una losa de vidrio
   negro, la lista arriba y lo que escribes abajo, sin íconos (en tinta), la
   entrada elegida invertida en blanco como el workspace activo. Paleta fija. */

@import "~/.config/jale/wallust/colors-jale.rasi"

configuration {
    modi:                       "drun,run,filebrowser";
    show-icons:                 false;
    display-drun:               "abrir";
    display-run:                "correr";
    display-filebrowser:        "archivos";
    display-window:             "ventanas";
    drun-display-format:        "{name}";
    hover-select:               true;
    me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
    window-format:              "{w} · {c} · {t}";
}

* {
    font:                       "{{font}} 13";
    background-color:           transparent;
    text-color:                 @fg;
}

window {
    width:                      620px;
    location:                   south;
    anchor:                     south;
    y-offset:                   -66px;
    border:                     1px;
    border-color:               @hi-a12;
    border-radius:              20px;
    background-color:           @bg0-aeb;
    padding:                    0;
}

mainbox {
    orientation:                vertical;
    spacing:                    0;
    children:                   [ "mode-switcher", "message", "listview", "inputbar" ];

}

inputbar {
    spacing:                    12px;
    padding:                    14px 18px;
    border:                     1px 0 0 0;
    border-color:               @hi-a12;
    background-color:           transparent;
    children:                   [ "prompt", "textbox-prompt-colon", "entry" ];
}

prompt {
    text-color:                 @brillo;
    
}

textbox-prompt-colon {
    enabled:                    true;
    expand:                     false;
    str:                        "·";
    text-color:                 @dim;
}

entry {
    placeholder:                "escribe";
    placeholder-color:          @dim;
    cursor:                     text;
    text-color:                 @hi;
}

listview {
    columns:                    1;
    lines:                      8;
    spacing:                    0;
    padding:                    10px 10px;
    dynamic:                    true;
    cycle:                      true;
    scrollbar:                  false;
    fixed-height:               true;
}

element {
    spacing:                    12px;
    padding:                    8px 18px 8px 16px;
    border:                     0 0 0 3px;
    border-color:               transparent;
    border-radius:              8px;
    cursor:                     pointer;
}

element normal.normal,
element alternate.normal {
    background-color:           transparent;
    text-color:                 @fg;
}

element normal.active,
element alternate.active {
    text-color:                 @ok;
}

element normal.urgent,
element alternate.urgent {
    text-color:                 @warn;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color:           @acc;
    border:                     0;
    border-color:               transparent;
    border-radius:              14px;
    text-color:                 @bg0;
}

element-icon {
    size:                       24px;
    cursor:                     inherit;
}

element-text {
    text-color:                 inherit;
    vertical-align:             0.5;
    cursor:                     inherit;
}

mode-switcher {
    spacing:                    0;
    border:                     0 0 1px 0;
    border-color:               @hi-a12;
}

button {
    padding:                    9px;
    text-color:                 @dim;
    cursor:                     pointer;
}

button selected {
    background-color:           transparent;
    text-color:                 @brillo;
}

message {
    padding:                    10px 18px;
    border:                     0 0 1px 0;
    border-color:               @bg2;
}

textbox {
    text-color:                 @dim;
    vertical-align:             0.5;
}

error-message {
    padding:                    14px;
    background-color:           @bg0;
}
