/* Dany Brutalist — editorial: líneas de 2px, mayúsculas espaciadas,
   selección con barra lateral en acento.
   Colores vía wallust. */

configuration {
    modi:                       "drun,run,filebrowser";
    show-icons:                 true;
    display-drun:               "RUN /";
    display-run:                "CMD /";
    display-filebrowser:        "FILES /";
    display-window:             "WIN";
    drun-display-format:        "{name}";
    hover-select:               true;
    me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
    window-format:              "{w} · {c} · {t}";
}

@theme "~/.config/rofi/wallust/colors-rofi.rasi"

* {
    accent:                     @color12;
    bg:                         @normal-background;
    fg:                         @foreground;
    background-color:           transparent;
    text-color:                 @fg;
    font:                       "JetBrainsMono Nerd Font Bold 11";
}

window {
    width:                      620px;
    location:                   center;
    anchor:                     center;
    border:                     2px;
    border-color:               @fg;
    border-radius:              0px;
    background-color:           @bg;
}

mainbox {
    orientation:                vertical;
    spacing:                    0px;
    children:                   [ "inputbar", "message", "listview", "mode-switcher" ];
}

inputbar {
    spacing:                    0px;
    border:                     0px 0px 2px 0px;
    border-color:               @fg;
    children:                   [ "prompt", "entry" ];
}

prompt {
    padding:                    12px 0px 12px 16px;
    text-color:                 @accent;
}

textbox-prompt-colon {
    enabled:                    false;
}

entry {
    padding:                    12px 14px;
    placeholder:                "_";
    placeholder-color:          @color8;
    cursor:                     text;
}

listview {
    columns:                    1;
    lines:                      8;
    spacing:                    0px;
    dynamic:                    true;
    cycle:                      true;
    scrollbar:                  false;
    fixed-height:               true;
}

element {
    spacing:                    12px;
    padding:                    8px 14px;
    border:                     0px 0px 0px 3px;
    border-color:               transparent;
    cursor:                     pointer;
}

element normal.normal,
element alternate.normal {
    background-color:           transparent;
    text-color:                 @fg;
}

element normal.active,
element alternate.active {
    text-color:                 @accent;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color:           @color0;
    border-color:               @accent;
    text-color:                 @fg;
}

element-icon {
    size:                       22px;
    cursor:                     inherit;
}

element-text {
    text-color:                 inherit;
    vertical-align:             0.5;
    cursor:                     inherit;
}

mode-switcher {
    spacing:                    0px;
    border:                     2px 0px 0px 0px;
    border-color:               @fg;
}

button {
    padding:                    9px;
    text-color:                 @color8;
    cursor:                     pointer;
}

button selected {
    text-color:                 @accent;
}

message {
    padding:                    10px 14px;
    border:                     0px 0px 2px 0px;
    border-color:               @fg;
}

textbox {
    text-color:                 @fg;
    vertical-align:             0.5;
}

error-message {
    padding:                    12px;
    background-color:           @bg;
}
