// Look brutalist — fastfetch: sin logo, llaves en MAYÚSCULAS, bloques sólidos
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": " / ",
    "color": {
      "keys": "white",
      "title": "bright_red"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "color": {
        "user": "bright_red",
        "at": "white",
        "host": "white"
      }
    },
    {
      "type": "custom",
      "format": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    },
    {
      "type": "os",
      "key": "OS    "
    },
    {
      "type": "kernel",
      "key": "KERNEL"
    },
    {
      "type": "wm",
      "key": "WM    "
    },
    {
      "type": "shell",
      "key": "SHELL "
    },
    {
      "type": "terminal",
      "key": "TERM  "
    },
    {
      "type": "cpu",
      "key": "CPU   "
    },
    {
      "type": "gpu",
      "key": "GPU   ",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "RAM   "
    },
    {
      "type": "disk",
      "key": "DISK  ",
      "folders": "/"
    },
    {
      "type": "uptime",
      "key": "UPTIME"
    },
    {
      "type": "custom",
      "format": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    },
    {
      "type": "colors",
      "symbol": "block",
      "paddingLeft": 0
    },
    "break"
  ]
}
