// Look paper — fastfetch: sin logo, ficha impresa monocroma
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  —  ",
    "color": {
      "keys": "bright_black",
      "title": "default"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "────────────────────────────────"
    },
    {
      "type": "os",
      "key": "system  "
    },
    {
      "type": "kernel",
      "key": "kernel  "
    },
    {
      "type": "wm",
      "key": "desktop "
    },
    {
      "type": "shell",
      "key": "shell   "
    },
    {
      "type": "terminal",
      "key": "terminal"
    },
    {
      "type": "memory",
      "key": "memory  "
    },
    {
      "type": "uptime",
      "key": "uptime  "
    },
    "break"
  ]
}
