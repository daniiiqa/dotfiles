// Look fundidora — fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  ··  ",
    "color": {
      "keys": "magenta",
      "separator": "bright_black"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[33m▲\u001b[0m HORNO ALTO 3   \u001b[90mMONTERREY N.L.\u001b[0m"
    },
    {
      "type": "title",
      "format": "{user-name} / {host-name}",
      "color": {
        "user": "yellow",
        "at": "bright_black",
        "host": "yellow"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[90m┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉\u001b[0m"
    },
    {
      "type": "os",
      "key": "OS    "
    },
    {
      "type": "kernel",
      "key": "KERNEL"
    },
    {
      "type": "wm",
      "key": "WM    "
    },
    {
      "type": "shell",
      "key": "SHELL "
    },
    {
      "type": "terminal",
      "key": "TERM  "
    },
    {
      "type": "memory",
      "key": "MEM   "
    },
    {
      "type": "uptime",
      "key": "TURNO "
    },
    {
      "type": "custom",
      "format": "\u001b[90m┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[33m▁▂▃▅▆▇█\u001b[0m  \u001b[90mACERO\u001b[0m"
    },
    "break"
  ]
}
