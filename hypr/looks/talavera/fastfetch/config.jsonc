// Look talavera — fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  ··  ",
    "color": {
      "keys": "magenta",
      "separator": "bright_black"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[34m❖\u001b[0m talavera   \u001b[90mpuebla de los ángeles\u001b[0m"
    },
    {
      "type": "title",
      "format": "{user-name} / {host-name}",
      "color": {
        "user": "blue",
        "at": "bright_black",
        "host": "blue"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[90m──────────────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "os    "
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
      "type": "wm",
      "key": "wm    "
    },
    {
      "type": "shell",
      "key": "shell "
    },
    {
      "type": "terminal",
      "key": "term  "
    },
    {
      "type": "memory",
      "key": "mem   "
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "custom",
      "format": "\u001b[90m──────────────────────────────────\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[34m❋ ❋ ❋\u001b[0m  \u001b[33m✦\u001b[0m"
    },
    "break"
  ]
}
