// Look loteria — fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  ··  ",
    "color": {
      "keys": "magenta",
      "separator": "bright_black"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[31m¡LOTERÍA!\u001b[0m   \u001b[90mcorre y se va…\u001b[0m"
    },
    {
      "type": "title",
      "format": "{user-name} / {host-name}",
      "color": {
        "user": "red",
        "at": "bright_black",
        "host": "red"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m"
    },
    {
      "type": "os",
      "key": "1 · OS    "
    },
    {
      "type": "kernel",
      "key": "2 · KERNEL"
    },
    {
      "type": "wm",
      "key": "3 · WM    "
    },
    {
      "type": "shell",
      "key": "4 · SHELL "
    },
    {
      "type": "terminal",
      "key": "5 · TERM  "
    },
    {
      "type": "memory",
      "key": "6 · MEM   "
    },
    {
      "type": "uptime",
      "key": "7 · TIEMPO"
    },
    {
      "type": "custom",
      "format": "\u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[34m♦\u001b[0m \u001b[31m♥\u001b[0m \u001b[33m★\u001b[0m \u001b[32m☘\u001b[0m"
    },
    "break"
  ]
}
