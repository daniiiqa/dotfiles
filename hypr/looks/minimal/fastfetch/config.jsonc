// Look minimal — fastfetch: logo chico, llaves en minúscula, un solo acento
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "color": {
      "1": "bright_red",
      "2": "bright_red"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "bright_red",
      "title": "bright_red"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    "break",
    {
      "type": "os",
      "key": "os    "
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
      "type": "wm",
      "key": "wm    "
    },
    {
      "type": "shell",
      "key": "shell "
    },
    {
      "type": "terminal",
      "key": "term  "
    },
    {
      "type": "packages",
      "key": "pkgs  "
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "memory",
      "key": "mem   "
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 0
    },
    "break"
  ]
}
