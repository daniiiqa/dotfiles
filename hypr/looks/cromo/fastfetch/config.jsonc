// Look glass — fastfetch: logo blanco, iconos finos, tonos suaves
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "color": {
      "1": "white",
      "2": "white"
    },
    "padding": {
      "top": 2,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "   ",
    "color": {
      "keys": "bright_red",
      "separator": "bright_black"
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "format": "{user-name} · {host-name}"
    },
    "break",
    {
      "type": "os",
      "key": "  "
    },
    {
      "type": "kernel",
      "key": "  "
    },
    {
      "type": "wm",
      "key": "  "
    },
    {
      "type": "terminal",
      "key": "  "
    },
    {
      "type": "shell",
      "key": "  "
    },
    {
      "type": "packages",
      "key": "󰏖  "
    },
    {
      "type": "memory",
      "key": "󰍛  "
    },
    {
      "type": "uptime",
      "key": "󰅐  "
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 0
    }
  ]
}
