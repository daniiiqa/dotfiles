// Look nord — fastfetch: logo azul frost, iconos y llaves en frost
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "color": {
      "1": "cyan",
      "2": "blue"
    },
    "padding": {
      "top": 1,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan",
      "title": "blue"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "color": {
        "user": "cyan",
        "at": "bright_black",
        "host": "blue"
      }
    },
    {
      "type": "custom",
      "format": "──────────────────────────"
    },
    {
      "type": "os",
      "key": " os     "
    },
    {
      "type": "kernel",
      "key": " kernel "
    },
    {
      "type": "wm",
      "key": " wm     "
    },
    {
      "type": "terminal",
      "key": " term   "
    },
    {
      "type": "shell",
      "key": " shell  "
    },
    {
      "type": "packages",
      "key": "󰏖 pkgs   "
    },
    {
      "type": "memory",
      "key": "󰍛 mem    "
    },
    {
      "type": "uptime",
      "key": "󰅐 uptime "
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 0
    },
    "break"
  ]
}
