// Look pastel — fastfetch: logo en el acento, separadores de flor
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "color": {
      "1": "bright_red",
      "2": "bright_red"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  ✿  ",
    "color": {
      "keys": "bright_red",
      "separator": "bright_black"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "♡ {user-name}@{host-name}",
      "color": {
        "user": "bright_red",
        "host": "white"
      }
    },
    "break",
    {
      "type": "os",
      "key": "os    "
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
      "type": "wm",
      "key": "wm    "
    },
    {
      "type": "shell",
      "key": "shell "
    },
    {
      "type": "terminal",
      "key": "term  "
    },
    {
      "type": "memory",
      "key": "mem   "
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    "break",
    {
      "type": "colors",
      "symbol": "star",
      "paddingLeft": 0
    },
    "break"
  ]
}
