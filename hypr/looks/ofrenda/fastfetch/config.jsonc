// Look ofrenda — fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  ··  ",
    "color": {
      "keys": "magenta",
      "separator": "bright_black"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[33m✿\u001b[35m ✿ \u001b[36m✿\u001b[0m  ofrenda   \u001b[90mpara los que se fueron\u001b[0m"
    },
    {
      "type": "title",
      "format": "{user-name} / {host-name}",
      "color": {
        "user": "yellow",
        "at": "bright_black",
        "host": "yellow"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[90m┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄\u001b[0m"
    },
    {
      "type": "os",
      "key": "os       "
    },
    {
      "type": "kernel",
      "key": "kernel   "
    },
    {
      "type": "wm",
      "key": "wm       "
    },
    {
      "type": "shell",
      "key": "shell    "
    },
    {
      "type": "terminal",
      "key": "term     "
    },
    {
      "type": "memory",
      "key": "mem      "
    },
    {
      "type": "uptime",
      "key": "despierto"
    },
    {
      "type": "custom",
      "format": "\u001b[90m┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[35m⁂\u001b[0m  \u001b[90mque nadie se quede sin su vela\u001b[0m"
    },
    "break"
  ]
}
