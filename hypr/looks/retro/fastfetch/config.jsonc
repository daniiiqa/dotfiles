// Look retro — fastfetch: logo ASCII monocromo, llaves estilo prompt
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "color": {
      "1": "bright_red",
      "2": "bright_red"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " : ",
    "color": {
      "keys": "bright_red",
      "output": "bright_red",
      "separator": "bright_red"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "> SYSTEM REPORT_",
      "outputColor": "bright_red"
    },
    "break",
    {
      "type": "os",
      "key": "> os     "
    },
    {
      "type": "host",
      "key": "> machine"
    },
    {
      "type": "kernel",
      "key": "> kernel "
    },
    {
      "type": "uptime",
      "key": "> uptime "
    },
    {
      "type": "shell",
      "key": "> shell  "
    },
    {
      "type": "cpu",
      "key": "> cpu    "
    },
    {
      "type": "memory",
      "key": "> memory "
    },
    {
      "type": "disk",
      "key": "> disk   ",
      "folders": "/"
    },
    "break",
    {
      "type": "custom",
      "format": "READY.",
      "outputColor": "bright_red"
    },
    "break"
  ]
}
