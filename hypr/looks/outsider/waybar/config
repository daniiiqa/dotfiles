// Look outsider — barra tipo deck de cassette: etiquetas en minúscula,
// reloj con REC de camcorder (click: fecha estilo sello de VHS).
{
	"layer": "top",
	"reload_style_on_change": true,
	"exclusive": true,
	"passthrough": false,
	"position": "top",
	"height": 30,
	"spacing": 0,
	"fixed-center": true,
	"ipc": true,
	"margin-top": 10,
	"margin-left": 14,
	"margin-right": 14,
	"margin-bottom": 0,
	"modules-left": [
		"hyprland/workspaces#minimal",
		"custom/visualizer",
		"custom/app-i1",
		"custom/app-i2",
		"custom/app-i3",
		"custom/app-i4",
		"custom/app-i5",
		"custom/app-i6",
		"custom/app-i7",
		"custom/app-i8",
		"group/apps"
	],
	"modules-center": [
		"clock#minimal"
	],
	"modules-right": [
		"custom/recorder",
		"group/mobo_drawer",
		"group/audio",
		"network",
		"bluetooth",
		"custom/battery",
		"idle_inhibitor",
		"group/notify",
		"custom/power"
	],
	"hyprland/workspaces#minimal": {
		"all-outputs": true,
		"format": "{icon}",
		"show-special": false,
		"on-click": "activate",
		"on-scroll-up": "$HOME/.config/hypr/scripts/Hypr.sh workspace e+1",
		"on-scroll-down": "$HOME/.config/hypr/scripts/Hypr.sh workspace e-1",
		"persistent-workspaces": {
			"*": 5
		},
		"format-icons": {
			"1": "01",
			"2": "02",
			"3": "03",
			"4": "04",
			"5": "05",
			"6": "06",
			"7": "07",
			"8": "08",
			"9": "09",
			"10": "10",
			"default": "··"
		}
	},
	"clock#minimal": {
		"interval": 30,
		"format": "<span foreground=\"#d4523b\">●</span> rec  {:%H:%M}",
		"format-alt": "<span foreground=\"#e3b161\">{:%b %d %Y   %H:%M}</span>",
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
		"calendar": {
			"mode": "month",
			"weeks-pos": "",
			"on-scroll": 1,
			"format": {
				"today": "<b><u>{}</u></b>"
			}
		},
		"actions": {
			"on-scroll-up": "shift_up",
			"on-scroll-down": "shift_down"
		}
	},
	"group/mobo_drawer": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"children-class": "cpu",
			"transition-left-to-right": true
		},
		"modules": [
			"temperature",
			"cpu",
			"memory",
			"disk"
		]
	},
	"temperature": {
		"interval": 10,
		"tooltip": true,
		"hwmon-path": [
			"/sys/class/hwmon/hwmon1/temp1_input",
			"/sys/class/thermal/thermal_zone0/temp"
		],
		"critical-threshold": 82,
		"format-critical": "{temperatureC}°C {icon}",
		"format": "{temperatureC}°",
		"format-icons": [
			"󰈸"
		],
		"on-click-right": "$HOME/.config/hypr/scripts/Vato.sh system"
	},
	"cpu": {
		"format": "cpu {usage}%",
		"interval": 1,
		"min-length": 5,
		"format-alt-click": "click",
		"format-alt": "cpu {icon0}{icon1}{icon2}{icon3}",
		"format-icons": [
			"▁",
			"▂",
			"▃",
			"▄",
			"▅",
			"▆",
			"▇",
			"█"
		],
		"on-click-right": "$HOME/.config/hypr/scripts/Vato.sh system"
	},
	"memory": {
		"interval": 10,
		"format": "mem {used:0.1f}g",
		"format-alt": "mem {percentage}%",
		"format-alt-click": "click",
		"tooltip": true,
		"tooltip-format": "{used:0.1f}GB/{total:0.1f}G",
		"on-click-right": "$HOME/.config/hypr/scripts/Vato.sh system"
	},
	"disk": {
		"interval": 30,
		"path": "/",
		"format": "hdd {percentage_used}%",
		"tooltip-format": "{used} used out of {total} on {path} ({percentage_used}%)"
	},
	"group/audio": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"children-class": "pulseaudio",
			"transition-left-to-right": true
		},
		"modules": [
			"pulseaudio",
			"pulseaudio#microphone"
		]
	},
	"pulseaudio": {
		"format": "vol {volume}",
		"format-bluetooth": "{icon} 󰂰 {volume}%",
		"format-muted": "vol --",
		"format-icons": {
			"headphone": "",
			"hands-free": "",
			"headset": "",
			"phone": "",
			"portable": "",
			"car": "",
			"default": [
				"",
				"",
				"󰕾",
				""
			],
			"ignored-sinks": [
				"Easy Effects Sink"
			]
		},
		"scroll-step": 5.0,
		"on-click": "$HOME/.config/hypr/scripts/Volume.sh --toggle",
		"on-click-right": "$HOME/.config/hypr/scripts/Vato.sh audio",
		"on-scroll-up": "$HOME/.config/hypr/scripts/Volume.sh --inc",
		"on-scroll-down": "$HOME/.config/hypr/scripts/Volume.sh --dec",
		"tooltip-format": "{icon} {desc} | {volume}%",
		"smooth-scrolling-threshold": 1
	},
	"pulseaudio#microphone": {
		"format": "{format_source}",
		"format-source": " {volume}%",
		"format-source-muted": "",
		"on-click": "$HOME/.config/hypr/scripts/Volume.sh --toggle-mic",
		"on-click-right": "$HOME/.config/hypr/scripts/Vato.sh mic",
		"on-scroll-up": "$HOME/.config/hypr/scripts/Volume.sh --mic-inc",
		"on-scroll-down": "$HOME/.config/hypr/scripts/Volume.sh --mic-dec",
		"tooltip-format": "{source_desc} | {source_volume}%",
		"scroll-step": 5
	},
	"network": {
		"format": "net",
		"format-wifi": "wifi {signalStrength}",
		"format-ethernet": "lan",
		"format-disconnected": "offline",
		"tooltip-format": "{ipaddr}  {bandwidthUpBits}  {bandwidthDownBits}",
		"format-linked": "󰈁 {ifname} (No IP)",
		"tooltip-format-wifi": "{essid} {icon} {signalStrength}%",
		"tooltip-format-ethernet": "{ifname} 󰌘",
		"tooltip-format-disconnected": "󰌙 Disconnected",
		"max-length": 30,
		"format-icons": [
			"󰤯",
			"󰤟",
			"󰤢",
			"󰤥",
			"󰤨"
		],
		"on-click": "$HOME/.config/hypr/scripts/Vato.sh network",
		"on-click-right": "$HOME/.config/hypr/scripts/Vato.sh wifi"
	},
	"custom/battery": {
		"exec": "$HOME/.config/hypr/scripts/Battery.py status",
		"exec-if": "$HOME/.config/hypr/scripts/Battery.py has",
		"return-type": "json",
		"interval": 60,
		"signal": 11,
		"format": "{icon} {percentage}",
		"format-icons": {
			"discharging": [
				"bat"
			],
			"charging": [
				"bat+"
			],
			"full": [
				"ac"
			],
			"saver": [
				"eco"
			]
		},
		"tooltip": true,
		"on-click": "$HOME/.config/hypr/scripts/Battery.py profile",
		"on-click-right": "$HOME/.config/hypr/scripts/Battery.py saver"
	},
	"bluetooth": {
		"format": "bt",
		"format-disabled": "bt",
		"format-connected": "bt {num_connections}",
		"tooltip-format": " {device_alias}",
		"tooltip-format-connected": "{device_enumerate}",
		"tooltip-format-enumerate-connected": " {device_alias} 󰂄{device_battery_percentage}%",
		"tooltip": true,
		"on-click": "$HOME/.config/hypr/scripts/Vato.sh bluetooth",
		"format-off": "bt"
	},
	"idle_inhibitor": {
		"tooltip": true,
		"tooltip-format-activated": "Stay awake: on\nScreen won't dim, lock or sleep",
		"tooltip-format-deactivated": "Stay awake: off\nClick to keep the screen on",
		"format": "{icon}",
		"format-icons": {
			"activated": "awake",
			"deactivated": "zz"
		}
	},
	"group/notify": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"children-class": "custom/swaync",
			"transition-left-to-right": false
		},
		"modules": [
			"custom/swaync"
		]
	},
	"custom/swaync": {
		"tooltip": true,
		"format": "{} {icon} ",
		"format-icons": {
			"notification": "<span foreground='red'><sup></sup></span>",
			"none": "",
			"dnd-notification": "<span foreground='red'><sup></sup></span>",
			"dnd-none": "",
			"inhibited-notification": "<span foreground='red'><sup></sup></span>",
			"inhibited-none": "",
			"dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
			"dnd-inhibited-none": ""
		},
		"return-type": "json",
		"exec-if": "test -x $HOME/.local/bin/arre",
		"exec": "$HOME/.local/bin/arre waybar",
		"on-click": "$HOME/.config/hypr/scripts/Vato.sh notifications",
		"on-click-right": "$HOME/.local/bin/arre dnd toggle",
		"escape": true
	},
	"custom/power": {
		"format": " ⏏ ",
		"on-click": "$HOME/.config/hypr/scripts/Wlogout.sh",
		"on-click-right": "$HOME/.config/hypr/scripts/ChangeBlur.sh",
		"tooltip": true,
		"tooltip-format": "Left Click: Logout Menu\nRight Click: Change Blur"
	},
	"custom/app-i1": {
		"exec": "cat \"$XDG_RUNTIME_DIR/appstrip/i1\" 2>/dev/null",
		"return-type": "json",
		"interval": "once",
		"signal": 9,
		"format": "{}",
		"tooltip": true,
		"on-click": "$HOME/.config/hypr/scripts/AppStrip.py focus i1",
		"on-click-middle": "$HOME/.config/hypr/scripts/AppStrip.py close i1"
	},
