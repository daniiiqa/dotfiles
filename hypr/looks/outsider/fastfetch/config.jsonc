// Look outsider — fastfetch: etiqueta de cassette: pistas numeradas y REC
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  ··  ",
    "color": {
      "keys": "magenta",
      "separator": "bright_black"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[31m●\u001b[0m rec   \u001b[90mside a\u001b[0m"
    },
    {
      "type": "title",
      "format": "{user-name} / {host-name}",
      "color": {
        "user": "yellow",
        "at": "bright_black",
        "host": "yellow"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[90m┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄\u001b[0m"
    },
    {
      "type": "os",
      "key": "01  os     "
    },
    {
      "type": "kernel",
      "key": "02  kernel "
    },
    {
      "type": "wm",
      "key": "03  wm     "
    },
    {
      "type": "shell",
      "key": "04  shell  "
    },
    {
      "type": "terminal",
      "key": "05  term   "
    },
    {
      "type": "memory",
      "key": "06  mem    "
    },
    {
      "type": "uptime",
      "key": "07  runtime"
    },
    {
      "type": "custom",
      "format": "\u001b[90m┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[36m◂◂  ▶  ▸▸   \u001b[90mside b ↻\u001b[0m"
    },
    "break"
  ]
}
