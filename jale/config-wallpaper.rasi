/* Main Config (wallpaper) */

@import "~/.config/jale/config.rasi"  

/* ---- Configuration ---- */ 
configuration {
  modi: "drun";
  show-icons: true;   /* algunos looks (retro) los apagan en su theme */
}

window {
  width: 75%;
  height: inherit;
}

/* ---- Mainbox ---- */
mainbox {
  children:
    [ "inputbar", "listview"];
}

entry {
  expand: true;
  placeholder: "wallpapers";
  horizontal-align: 0.5;
  horizontal-align: 0.5;
}

/* ---- Listview ---- */
listview {
  columns: 6;
  lines: 2;
  spacing: 20px;
  padding: 10px;
  columns: 6;
  lines: 2;
  flow: horizontal;
  fixed-width: true;
  fixed-height: true;
  cycle: true;
}

/* ---- Element ---- */
element {
  orientation: vertical;
  padding: 0px;
  spacing: 0px;
  border-radius: 10px;
  padding: 0px;
  margin: 0px;
}

/* Custom (dany): la selección la marca el look (video inverso en retro);
   con el fondo transparente su texto quedaba invisible */

element-icon {
    text-color:                  inherit;
    size:                        10%;
    /* Custom (dany): sin margen negativo (el truco de rofi): jale llena la
       celda con la miniatura en 16:9, sin encimarse con las de al lado */
    margin:                      0px;
    cursor:                      inherit;
}

element-text {
  vertical-align: 0.5;
  horizontal-align: 0.5;
  padding: 6px;
  margin: 6px;
}