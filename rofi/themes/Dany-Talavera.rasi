/* Dany Talavera — el menú es un plato de talavera: esmalte crema, doble filo cobalto,
   la entrada elegida pintada en azul. Paleta fija. */

configuration {
    modi:                       "drun,run,filebrowser";
    show-icons:                 true;
    display-drun:               "talavera";
    display-run:                "abrir";
    display-filebrowser:        "loza";
    display-window:             "vitrina";
    drun-display-format:        "{name}";
    hover-select:               true;
    me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
    window-format:              "{w} · {c} · {t}";
}

* {
    bg0:                        #f6f1e4;
    bg1:                        #ece4d0;
    bg2:                        #d9ccb0;
    bg3:                        #1f3f8f;
    dim:                        #6b7391;
    fg:                         #1b2340;
    hi:                         #0e1530;
    acc:                        #1f3f8f;
    acc2:                       #e3a51b;
    warn:                       #b5532a;
    ok:                         #3f8a5a;
    alt:                        #2f5bb8;
    cool:                       #2f5bb8;
    font:                       "MonaspiceXe Nerd Font 13";
    background-color:           transparent;
    text-color:                 @fg;
}

window {
    width:                      560px;
    location:                   center;
    anchor:                     center;
    border:                     3px;
    border-color:               @acc;
    border-radius:              18px;
    background-color:           @bg0;
    padding:                    4px;
}

mainbox {
    orientation:                vertical;
    spacing:                    0;
    children:                   [ "inputbar", "message", "listview", "mode-switcher" ];
    border:                     1px;
    border-color:               #1f3f8f73;
    border-radius:              14px;
}

inputbar {
    spacing:                    12px;
    padding:                    14px 18px;
    border:                     0 0 1px 0;
    border-color:               #1f3f8f66;
    background-color:           @bg1;
    children:                   [ "prompt", "textbox-prompt-colon", "entry" ];
}

prompt {
    text-color:                 @acc;
    
}

textbox-prompt-colon {
    enabled:                    true;
    expand:                     false;
    str:                        "❖";
    text-color:                 @acc2;
}

entry {
    placeholder:                "buscar…";
    placeholder-color:          @dim;
    cursor:                     text;
    text-color:                 @hi;
}

listview {
    columns:                    1;
    lines:                      8;
    spacing:                    4px;
    padding:                    8px 8px;
    dynamic:                    true;
    cycle:                      true;
    scrollbar:                  false;
    fixed-height:               true;
}

element {
    spacing:                    12px;
    padding:                    8px 18px;
    border:                     0;
    border-color:               transparent;
    border-radius:              12px;
    cursor:                     pointer;
}

element normal.normal,
element alternate.normal {
    background-color:           transparent;
    text-color:                 @fg;
}

element normal.active,
element alternate.active {
    text-color:                 @ok;
}

element normal.urgent,
element alternate.urgent {
    text-color:                 @warn;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color:           @acc;
    border:                     0;
    border-color:               @acc;
    text-color:                 @bg0;
}

element-icon {
    size:                       24px;
    cursor:                     inherit;
}

element-text {
    text-color:                 inherit;
    vertical-align:             0.5;
    cursor:                     inherit;
}

mode-switcher {
    spacing:                    0;
    border:                     1px 0 0 0;
    border-color:               @bg2;
}

button {
    padding:                    9px;
    text-color:                 @dim;
    cursor:                     pointer;
}

button selected {
    background-color:           @bg1;
    text-color:                 @acc;
}

message {
    padding:                    10px 18px;
    border:                     0 0 1px 0;
    border-color:               @bg2;
}

textbox {
    text-color:                 @dim;
    vertical-align:             0.5;
}

error-message {
    padding:                    14px;
    background-color:           @bg0;
}
