/* Dany Outsider — outsider house / lo-fi: el menú como la portada de un
   cassette (j-card). Fondo cálido casi negro, "side a" de prompt, la entrada
   elegida marcada con una barra rosa a la izquierda. Paleta fija. */

configuration {
    modi:                       "drun,run,filebrowser";
    show-icons:                 true;
    display-drun:               "side a";
    display-run:                "side b";
    display-filebrowser:        "tapes";
    display-window:             "deck";
    drun-display-format:        "{name}";
    hover-select:               true;
    me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
    window-format:              "{w} · {c} · {t}";
}

* {
    ink0:                       #15120e;
    ink1:                       #1f1b16;
    ink2:                       #2d2820;
    ink3:                       #4d453a;
    dust:                       #8f8574;
    cream:                      #e8dcc3;
    paper:                      #f3ead6;
    rose:                       #d99a8b;
    teal:                       #87aaa1;
    amber:                      #e3b161;
    rec:                        #d4523b;
    font:                       "FantasqueSansM Nerd Font 13";
    background-color:           transparent;
    text-color:                 @cream;
}

window {
    width:                      560px;
    location:                   center;
    anchor:                     center;
    border:                     1px;
    border-color:               @ink3;
    border-radius:              3px;
    background-color:           @ink0;
    padding:                    0;
}

mainbox {
    orientation:                vertical;
    spacing:                    0;
    children:                   [ "inputbar", "message", "listview", "mode-switcher" ];
}

/* franja de arriba: como la etiqueta del cassette */
inputbar {
    spacing:                    12px;
    padding:                    14px 18px;
    border:                     0 0 1px 0;
    border-color:               @ink2;
    background-color:           @ink1;
    children:                   [ "prompt", "entry" ];
}

prompt {
    text-color:                 @rec;
}

textbox-prompt-colon {
    enabled:                    true;
    str:                        "▸";
    text-color:                 @ink3;
}

entry {
    placeholder:                "search the tape…";
    placeholder-color:          @ink3;
    cursor:                     text;
    text-color:                 @paper;
}

listview {
    columns:                    1;
    lines:                      8;
    spacing:                    0;
    padding:                    8px 0;
    dynamic:                    true;
    cycle:                      true;
    scrollbar:                  false;
    fixed-height:               true;
}

element {
    spacing:                    12px;
    padding:                    8px 18px 8px 16px;
    border:                     0 0 0 2px;
    border-color:               transparent;
    cursor:                     pointer;
}

element normal.normal,
element alternate.normal {
    background-color:           transparent;
    text-color:                 @cream;
}

element normal.active,
element alternate.active {
    text-color:                 @teal;
}

element normal.urgent,
element alternate.urgent {
    text-color:                 @rec;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color:           @ink1;
    border-color:               @rose;
    text-color:                 @paper;
}

element-icon {
    size:                       22px;
    cursor:                     inherit;
}

element-text {
    text-color:                 inherit;
    vertical-align:             0.5;
    cursor:                     inherit;
}

mode-switcher {
    spacing:                    0;
    border:                     1px 0 0 0;
    border-color:               @ink2;
}

button {
    padding:                    9px;
    text-color:                 @ink3;
    cursor:                     pointer;
}

button selected {
    background-color:           @ink1;
    text-color:                 @amber;
}

message {
    padding:                    10px 18px;
    border:                     0 0 1px 0;
    border-color:               @ink2;
}

textbox {
    text-color:                 @dust;
    vertical-align:             0.5;
}

error-message {
    padding:                    14px;
    background-color:           @ink0;
}
