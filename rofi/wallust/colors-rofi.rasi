 /* wallust template - colors-rofi */

* {
active-background: #AF754A;
active-foreground: #FAF1DE;
normal-background: #000008;
normal-foreground: #FAF1DE;
urgent-background: #8E96AE;
urgent-foreground: #FAF1DE;

alternate-active-background: #86716E;
alternate-active-foreground: #FAF1DE;
alternate-normal-background: #000008;
alternate-normal-foreground: #FAF1DE;
alternate-urgent-background: #000008;
alternate-urgent-foreground: #FAF1DE;

selected-active-background: #AF754A;
selected-active-foreground: #000008;
selected-normal-background: #AF754A;
selected-normal-foreground: #000008;
selected-urgent-background: #86716E;
selected-urgent-foreground: #000008;

background-color: #000008;
background: rgba(0,0,0,0.7);
foreground: #FAF1DE;
border-color: #AF754A;

color0: #000009;
color1: #76778E;
color2: #887674;
color3: #897674;
color4: #957054;
color5: #727789;
color6: #B5A179;
color7: #F0E3C8;
color8: #A89F8C;
color9: #767791;
color10: #86716E;
color11: #86716E;
color12: #AF754A;
color13: #8E96AE;
color14: #F1D7A1;
color15: #F0E3C8;


}

