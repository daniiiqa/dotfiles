 /* wallust template - colors-rofi */

* {
active-background: #3E6E5B;
active-foreground: #D9E8ED;
normal-background: #1E1F22;
normal-foreground: #D9E8ED;
urgent-background: #566F98;
urgent-foreground: #D9E8ED;

alternate-active-background: #2E4B48;
alternate-active-foreground: #D9E8ED;
alternate-normal-background: #1E1F22;
alternate-normal-foreground: #D9E8ED;
alternate-urgent-background: #1E1F22;
alternate-urgent-foreground: #D9E8ED;

selected-active-background: #3E6E5B;
selected-active-foreground: #1E1F22;
selected-normal-background: #3E6E5B;
selected-normal-foreground: #1E1F22;
