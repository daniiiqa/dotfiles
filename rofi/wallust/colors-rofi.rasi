 /* wallust template - colors-rofi */

* {
active-background: #8579AC;
active-foreground: #FDF9FE;
normal-background: #100B1F;
normal-foreground: #FDF9FE;
urgent-background: #857BA6;
urgent-foreground: #FDF9FE;

alternate-active-background: #8D6CC6;
alternate-active-foreground: #FDF9FE;
alternate-normal-background: #100B1F;
alternate-normal-foreground: #FDF9FE;
alternate-urgent-background: #100B1F;
alternate-urgent-foreground: #FDF9FE;

selected-active-background: #8579AC;
selected-active-foreground: #100B1F;
selected-normal-background: #8579AC;
selected-normal-foreground: #100B1F;
selected-urgent-background: #8D6CC6;
selected-urgent-foreground: #100B1F;

background-color: #100B1F;
background: rgba(0,0,0,0.7);
foreground: #FDF9FE;
border-color: #8579AC;

color0: #403D45;
color1: #BAB2BC;
color2: #8E6CB5;
color3: #8A75AD;
color4: #8378A6;
color5: #837AA1;
color6: #827C9B;
color7: #F3EEF5;
color8: #AAA6AB;
color9: #F8EDFB;
color10: #975FD8;
color11: #8D6CC6;
