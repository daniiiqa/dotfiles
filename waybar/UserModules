/* Waybar Modules Extras */

/* This is where you can add Extra Modules you wish. copy.sh will try to restore*/
/* this file along with the unique configs and styles. */
/* IMPORTANT, be mindful with , or ". else waybar will not start */

{

/* Custom (dany): Steam y Discord como glyphs tematizados (como el de Spotify)
   en lugar de sus iconos de tray. La clase running/stopped viene del exec y
   el style.css la usa para atenuar la app apagada. Click = enfocar o lanzar. */

"custom/steam": {
	"format": "󰓓",
	"exec": "pgrep -x steam >/dev/null && echo '{\"text\":\"\",\"class\":\"running\",\"tooltip\":\"Steam — corriendo\"}' || echo '{\"text\":\"\",\"class\":\"stopped\",\"tooltip\":\"Steam — click para abrir\"}'",
	"return-type": "json",
	"interval": 5,
	"on-click": "$HOME/.config/hypr/UserScripts/FocusOrLaunch.sh steam steam",
},

"custom/discord": {
	"format": "󰙯",
	"exec": "pgrep -f '[Dd]iscord' >/dev/null && echo '{\"text\":\"\",\"class\":\"running\",\"tooltip\":\"Discord — corriendo\"}' || echo '{\"text\":\"\",\"class\":\"stopped\",\"tooltip\":\"Discord — click para abrir\"}'",
	"return-type": "json",
	"interval": 5,
	"on-click": "$HOME/.config/hypr/UserScripts/FocusOrLaunch.sh discord discord",
},

}
