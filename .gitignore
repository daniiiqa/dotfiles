# Dotfiles repo: ignora TODO por default, whitelist solo el rice.
/*

# ── Carpetas del rice ──
!/.gitignore
!/README.md
!/README.es.md
!/install.sh
!/btop/
!/cava/
!/fastfetch/
!/hypr/
!/kitty/
!/Kvantum/
!/qt5ct/
!/qt6ct/
!/jale/
!/swappy/
!/swaync/
!/wallust/
!/wlogout/
!/rola/
!/sddm/

# ── Volátiles / generados dentro de las carpetas trackeadas ──
# Wallpapers binarios que cambian con cada fondo (swww los regenera)
hypr/wallpaper_effects/
# Marker de primer arranque de los dots
hypr/.initial_startup_done
# Logs
*.log
btop/btop.log
# Look activo (lo escribe LookSwitch.sh)
hypr/looks/.current
# Caché de Python
__pycache__/
# Pantallas de cada máquina (las escribe nwg-displays; Hyprland lee los .lua,
# los .conf ya no se cargan desde 0.57)
hypr/monitors.lua
hypr/workspaces.lua
hypr/monitors.conf
hypr/workspaces.conf
# Tamaño de letra aplicado (lo escribe FontSize.py)
hypr/looks/.fontsize
jale/discada-font.rasi

# ── Archivos vivos que cambian solos (no se trackean) ──
# Copias del look activo: salen de hypr/looks/<look>/ (LookSwitch.sh / install.sh)
/fastfetch/config.jsonc
/hypr/conf/animations.conf
/hypr/conf/decorations.conf
/hypr/conf/animations.lua
/hypr/conf/decorations.lua
/hypr/hyprlock.conf
/kitty/kitty.conf
/jale/0-shared-fonts.rasi
/jale/config.rasi
/jale/theme.rasi
/rola/look.json
/sddm/look.conf
/swaync/style.css
/wallust/wallust.toml
/wlogout/style.css
# Generados por wallust con cada wallpaper y ajustes que rola reescribe;
# install.sh pone las semillas de hypr/seed/ si faltan
/wlogout/wallust/colors-wlogout.css
/jale/wallust/colors-jale.rasi
/hypr/wallust/wallust-hyprland.conf
/hypr/wallust/wallust-hyprland.lua
/kitty/kitty-themes/01-Wallust.conf
/cava/config
/rola/config.json
# Paleta Qt del look (la escribe leña apps)
/qt5ct/colors/discada.conf
/qt6ct/colors/discada.conf
/hypr/conf/livewallpaper.conf
# Tus ajustes de discada y del grabador (semillas en hypr/seed/)
/hypr/discada.conf
/hypr/recorder.conf
/empalme/bar.json
/empalme/colors.json
